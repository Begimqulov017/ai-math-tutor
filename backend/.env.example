# Up to 8 Gemini keys, used round-robin with automatic failover. One key is enough to start.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Optional OpenAI API key for ultra-natural TTS voice (tts-1 with nova / alloy)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Long random string (python -c "import secrets;print(secrets.token_urlsafe(48))"). Required in production.
JWT_SECRET=
# CORS is open to every origin (no setting needed). CORS_ORIGINS is optional and only read by config.py.
# PostgreSQL link (Neon / Supabase), e.g. postgresql://user:password@host/dbname?sslmode=require
# Leave EMPTY on your computer: a local SQLite file (backend/app.db) is used automatically.
DATABASE_URL=

# Guests (not logged in): at most this many DIFFERENT problems per IP address. 0 = unlimited.
GUEST_PROBLEM_LIMIT=3
# 0 = the limit never resets; e.g. 24 = resets after 24 hours
GUEST_WINDOW_HOURS=0
# Real visitor IP behind the hosting proxy. Check https://<backend>/api/ip-check from your phone (mobile data)
# and set ONE of these until "ip" shows your real public IP:
#   CLIENT_IP_HEADER=true-client-ip      (header set by Cloudflare, which Render uses at its edge)
#   TRUSTED_PROXY_HOPS=1                 (n-th X-Forwarded-For entry from the right; try 2 on Render)
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

# Every logged-in user may analyse this many problems per day (resets at midnight, Tashkent time)
DAILY_TOKENS=50
# Admin panel master password: EXACTLY 16 digits. Set it only here / in the server's environment variables.
# Leave empty to disable the admin panel completely.
ADMIN_PASSWORD=
ADMIN_TOKEN_HOURS=2

# ---- E-mail verification (6-digit code sent before the account is created) ----
# Render's FREE tier blocks SMTP ports, so use the HTTPS API of Brevo (free plan; verify a sender address there):
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=AI Math Tutor
# ...or a normal SMTP server (works on a VPS / paid hosting, NOT on Render free):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Local development without any mail service: print the code in the server console instead
EMAIL_DEV_LOG=
# "false" = register without any e-mail code (only for local tests)
REQUIRE_EMAIL_VERIFICATION=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# ---- Subscription plans (activated by the admin after a manual payment) ----
PREMIUM_DAILY_TOKENS=200
VIP_DAILY_TOKENS=500
CHAT_MESSAGES_PER_TOKEN=3
LLM_LANE_SIZE=6
GEMINI_MODEL_PREMIUM=
GEMINI_MODEL_VIP=
