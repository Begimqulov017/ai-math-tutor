# Up to 8 Gemini keys, used round-robin with automatic failover. One key is enough to start.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_MODEL=gemini-3-flash-preview

# Long random string (python -c "import secrets;print(secrets.token_urlsafe(48))"). Required in production.
JWT_SECRET=
# Comma separated list of frontend addresses that may call the API
CORS_ORIGINS=http://localhost:5173
# PostgreSQL link (Neon / Supabase), e.g. postgresql://user:password@host/dbname?sslmode=require
# Leave EMPTY on your computer: a local SQLite file (backend/app.db) is used automatically.
DATABASE_URL=
